# ==========================================================
# Remnant X — Model API Configuration
# ==========================================================

# Baseten: optional chat-completion provider
BASETEN_API_KEY="PASTE_YOUR_REAL_BASETEN_KEY_HERE"
BASETEN_BASE_URL="https://inference.baseten.co/v1"
BASETEN_MODEL="meta-models/muse-spark-open-1026"

# Meta Model API: required for live SAM; optional for chat completions
META_API_KEY="PASTE_YOUR_REAL_META_API_KEY_HERE"
META_BASE_URL="https://api.meta.ai/v1"
META_SPARK_MODEL="muse-spark-1.3"
META_SAM_MODEL="sam-3.1"

# baseten (Muse Spark Open) by default; meta selects Muse Spark 1.3 directly.
REMNANTX_ORDER_PROVIDER="baseten"

# Fireworks: optional failover and one grounded repair of rejected order extraction
FIREWORKS_API_KEY="PASTE_YOUR_FW_API_KEY_HERE"
FIREWORKS_BASE_URL="https://api.fireworks.ai/inference/v1"
FIREWORKS_MODEL="accounts/fireworks/models/muse-spark-open"

# Local runtime. SAM uses Meta Responses directly; Modal is not required.
# Demo mode can use a separate database via scripts/start.ps1 -Demo.
REMNANTX_DB_PATH="warehouse.db"
REMNANTX_ARTIFACT_DIR="artifacts"
